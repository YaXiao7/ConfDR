# Copy this file to <CONFDR_ROOT>/tmp/baseline-keys.env and fill in your own values.
# Never commit the filled-in file.
#
# Any OpenAI-compatible chat-completions endpoint works.
OPENAI_API_BASE=https://api.example.com/v1
OPENAI_API_KEY=replace-with-your-key
CHEAP_MODEL=gpt-5.6-terra

# Optional overrides read by ConfDR itself (default to the three values above).
# CONFDR_LLM_BASE_URL=
# CONFDR_LLM_API_KEY=
# CONFDR_LLM_MODEL=
